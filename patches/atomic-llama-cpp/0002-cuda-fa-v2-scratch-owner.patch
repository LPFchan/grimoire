+            cudaError_t s = cudaFree(entry.v);
+            if (s != cudaSuccess) {
+                GGML_LOG_DEBUG("V2: cudaFree(retired V) returned %s\n", cudaGetErrorString(s));
+            }
+            entry.v = nullptr;
+        }
+        for (cudaEvent_t e : entry.events) {
+            if (e != nullptr) {
+                cudaError_t s = cudaEventDestroy(e);
+                if (s != cudaSuccess) {
+                    GGML_LOG_DEBUG("V2: cudaEventDestroy(retired event) returned %s\n",
+                                   cudaGetErrorString(s));
+                }
+            }
+        }
+        entry.events.clear();
+    };
+
+    // First pass: opportunistic poll-based drain.
+    for (auto it = ctx->retired_fattn_allocs.begin(); it != ctx->retired_fattn_allocs.end();) {
+        if (entry_ready(*it)) {
+            reclaim(*it);
+            it = ctx->retired_fattn_allocs.erase(it);
+        } else {
+            ++it;
+        }
+    }
+
+    if (ctx->retired_fattn_allocs.size() <= GGML_V2_RETIRED_FATTN_THRESHOLD) {
+        return;
+    }
+
+    // §3 step 1 path (a): regression-class signal + per-slot blocking sync.
+    // We are inside fattn_compute_mu but cudaStreamSynchronize is allowed on
+    // populated slots (it is NOT cudaDeviceSynchronize, which is reserved for
+    // the destructor). Avoids calling ctx->stream(...) which would lazily
+    // create empty slots inside the lock window.
+    GGML_LOG_WARN("V2: retired fattn list = %zu entries (threshold %zu); forcing per-stream sync\n",
+                  ctx->retired_fattn_allocs.size(), GGML_V2_RETIRED_FATTN_THRESHOLD);
+
+    for (int s = 0; s < GGML_CUDA_MAX_STREAMS; ++s) {
+        cudaStream_t stream = ctx->streams[ctx->device][s];
+        if (stream == nullptr) {
+            continue;
+        }
+        cudaError_t sstat = cudaStreamSynchronize(stream);
+        if (sstat != cudaSuccess) {
+            GGML_LOG_DEBUG("V2: cudaStreamSynchronize during retired drain returned %s\n",
+                           cudaGetErrorString(sstat));
+        }
+    }
+
+    // Re-drain. After per-stream sync everything queued before this point
+    // has completed, so all events for entries on this device should signal.
+    for (auto it = ctx->retired_fattn_allocs.begin(); it != ctx->retired_fattn_allocs.end();) {
+        if (entry_ready(*it)) {
+            reclaim(*it);
+            it = ctx->retired_fattn_allocs.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
