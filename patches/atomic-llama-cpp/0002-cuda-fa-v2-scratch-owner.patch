+// V2 sizing helper (RSH-20260523-001 §2). See fattn.cuh for the contract.
+// Mirrors the K_f16/V_f16 allocation gates in launch_fattn() (fattn-common.cuh
+// ~1340, ~1367). The earlier "VEC contributes zero" shortcut is wrong: when
+// the FATTN_VEC_CASE macro (line 223-231) accepts runtime K->type == F32 and
+// routes it through the F16 template, need_f16_K becomes true and the gate
+// fires. Correct VEC rule: K allocates when K->type == GGML_TYPE_F32;
+// V allocates when V->type == GGML_TYPE_F32 AND !V_is_K_view.
+void ggml_cuda_flash_attn_ext_f16_scratch_size(
+    int device, const ggml_tensor * dst, size_t * k_bytes, size_t * v_bytes) {
+
+    *k_bytes = 0;
+    *v_bytes = 0;
+
+    if (dst == nullptr || dst->op != GGML_OP_FLASH_ATTN_EXT) {
+        return;
+    }
+    if (dst->src[1] == nullptr || dst->src[2] == nullptr) {
+        return;
+    }
+
+    const best_fattn_kernel kernel = ggml_cuda_get_best_fattn_kernel(device, dst);
+    if (kernel == BEST_FATTN_KERNEL_NONE) {
+        return; // launch_fattn() will abort at execution; sizing returns 0.
+    }
+
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+
+    const bool V_is_K_view = ggml_cuda_fattn_V_is_K_view(V, K);
+
+    bool need_k_scratch = false;
+    bool need_v_scratch = false;
+
+    if (kernel == BEST_FATTN_KERNEL_VEC) {
+        // VEC: need_f16_K iff template's type_K==F16 and runtime K is F32
+        // (the FATTN_VEC_CASE macro at fattn.cu:223-231 accepts F32 routed
+        // through the F16 template). Same for V.
+        need_k_scratch = (K->type == GGML_TYPE_F32);
+        need_v_scratch = (V->type == GGML_TYPE_F32);
+    } else {
+        // TILE, WMMA, MMA: launch_fattn called with need_f16_K = need_f16_V = true.
+        // Each side allocates when its tensor is not native F16.
+        need_k_scratch = (K->type != GGML_TYPE_F16);
+        need_v_scratch = (V->type != GGML_TYPE_F16);
+    }
+
+    if (V_is_K_view) {
+        // launch_fattn short-circuits V_data = K_data when V_is_K_view
+        // (fattn-common.cuh ~1368-1372). V scratch is unused.
+        need_v_scratch = false;
+    }
+
+    if (need_k_scratch) {
+        *k_bytes = (size_t) ggml_nelements(K) * sizeof(half);
+    }
+    if (need_v_scratch) {
+        *v_bytes = (size_t) ggml_nelements(V) * sizeof(half);
+    }
+}
