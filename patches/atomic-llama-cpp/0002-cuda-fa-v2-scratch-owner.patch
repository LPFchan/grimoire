+// V2 debug failure injection (RSH-20260523-001 §Validation Requirements).
+// Env GGML_DEBUG_FORCE_FA_SCRATCH_FAIL=1 causes the next reserve/grow to
+// return cudaErrorMemoryAllocation. Single-shot via atomic compare-exchange so
+// each set of the env produces exactly one forced failure. Tests poll the env
+// before each attempt by re-reading getenv each time the gate fires.
+static bool ggml_cuda_v2_consume_fa_scratch_failure_injection() {
+#ifdef NDEBUG
+    return false;
+#else
+    const char * env = getenv("GGML_DEBUG_FORCE_FA_SCRATCH_FAIL");
+    if (env == nullptr || atoi(env) != 1) {
+        return false;
+    }
+    static std::atomic<int> consumed_count{0};
+    int prev = consumed_count.fetch_add(1, std::memory_order_relaxed);
+    // Re-arm semantics: this returns true once per process unless the test
+    // harness explicitly resets `GGML_DEBUG_FORCE_FA_SCRATCH_FAIL_GEN` between
+    // calls (read via the gen helper below) to drive cases (a), (b), (c) from
+    // the RSH validation matrix.
+    const char * gen_env = getenv("GGML_DEBUG_FORCE_FA_SCRATCH_FAIL_GEN");
+    int gen_target = gen_env != nullptr ? atoi(gen_env) : 0;
+    return prev <= gen_target;
+#endif
+}
