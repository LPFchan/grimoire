+// V2 §7 side-effect-free stream-slot predictor (RSH-20260523-001).
+// Parallel implementation of the live state machine in
+// ggml_cuda_graph_evaluate_and_capture (try_launch_concurrent_event closure
+// plus the in_concurrent_event branch of the per-node loop). MUST NOT call
+// cudaEventRecord, cudaStreamWaitEvent, concurrent_events.clear(), nor
+// mutate curr_stream_no on the cuda_ctx — all of those have side effects on
+// the live path that would corrupt subsequent compute.
+//
+// Returns the predicted execution stream slot for the FA node at `fa_node_idx`
+// in cgraph. Production (no concurrent_events populated, OR
+// should_launch_concurrent_events == false) deterministically returns 0, which
+// matches the live path's behavior of clearing concurrent_events at
+// evaluate_and_capture entry and running everything on the main stream.
+//
+// Approximation: this walker does not replicate the live path's fusion-skip
+// logic (i - prev_i > 1 → try_launch on prev_node). Fusion does not directly
+// involve FA nodes; the affected case is when a concurrent event fires on a
+// non-immediately-previous node. The debug assert at the FA enqueue site
+// inside evaluate_and_capture, under fattn_compute_mu, catches any drift
+// before stale scratch is captured into a graph.
+static int ggml_cuda_v2_predict_fa_slot(
+    ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph, int fa_node_idx) {
+
+    const ggml_cuda_stream_context & stream_ctx = ctx->concurrent_stream_context;
+    if (stream_ctx.concurrent_events.empty()) {
+        return 0;
+    }
+
+    bool should_launch = true;
+    for (const auto & [tensor, event] : stream_ctx.concurrent_events) {
+        if (!event.is_valid()) {
+            should_launch = false;
+            break;
+        }
+    }
+    if (!should_launch) {
+        // Live path clears concurrent_events for this compute window;
+        // every FA node executes on slot 0.
+        return 0;
+    }
+
+    int  predicted_slot = 0;
+    bool active = false;
+    const ggml_cuda_concurrent_event * cur = nullptr;
+
+    for (int i = 0; i <= fa_node_idx; ++i) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        if (node == nullptr) {
+            continue;
+        }
+        if (active) {
+            if (node == cur->join_node) {
+                predicted_slot = 0;
+                active = false;
+                cur = nullptr;
+            } else {
+                auto it = cur->stream_mapping.find(node);
+                if (it != cur->stream_mapping.end()) {
+                    predicted_slot = it->second;
+                }
+                // else: keep previous slot (matches live path which would
+                // also keep curr_stream_no when the node isn't in the map).
+            }
+        } else {
+            auto it = stream_ctx.concurrent_events.find(node);
+            if (it != stream_ctx.concurrent_events.end()) {
+                cur = &it->second;
+                active = true;
+                // Live path: try_launch_concurrent_event records the fork
+                // event on slot 0 (= predicted_slot). The launched node itself
+                // executes on slot mapping[node] if it's in the map; otherwise
+                // it remains the fork node on slot 0.
+                auto m = cur->stream_mapping.find(node);
+                if (m != cur->stream_mapping.end()) {
+                    predicted_slot = m->second;
+                }
+            }
+        }
+    }
+    return predicted_slot;
+}
+
+// V2 §3 steps 2-5 (RSH-20260523-001): preflight FA scratch reservation for the
+// upcoming compute window. Called by graph_compute with fattn_compute_mu held.
+//
+// Step 2: sweep cgraph for OP_FLASH_ATTN_EXT nodes; per-node call the §2
+// sizing helper to get K/V byte needs.
+// Step 3: predict the execution stream slot for each FA node (V2-5 §7 will
+// implement the live predictor; for now all FA nodes are predicted to slot 0,
+// which is correct in production: Atomic graph optimization early-exits unless
+// `ggml_backend_cuda_get_device_count() == 1`, and on the dual-GPU Grimoire
+// host that branch never fires; CUDA_VISIBLE_DEVICES single-GPU tests will
+// exercise the nonzero-stream code path once §7 lands).
+// Step 4: reserve or grow fattn_scratch[device][slot] using raw cudaError_t.
+// Step 5: on growth, invalidate every cuda_graphs entry whose
+// fa_borrowed_streams contains the grown slot, and move the old pointer to
+// the retired list with events recorded on every populated launch stream.
+//
+// Returns true on success; false on allocation failure (caller returns
+// GGML_STATUS_ALLOC_FAILED without entering the existing decision/capture/
+// launch block, without advancing node_props, without changing warmup state,
+// and without leaving partial state).
+static bool ggml_cuda_v2_preflight_fa_scratch(
+    ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph) {
+
+    if (cgraph == nullptr) {
+        return true;
+    }
+
+    // Step 2 + 3: read-only sweep, build per-slot byte needs.
+    size_t need_k[GGML_CUDA_MAX_STREAMS] = {0};
+    size_t need_v[GGML_CUDA_MAX_STREAMS] = {0};
+
+    bool any_fa = false;
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        if (node == nullptr || node->op != GGML_OP_FLASH_ATTN_EXT) {
+            continue;
+        }
+        size_t k_bytes = 0, v_bytes = 0;
+        ggml_cuda_flash_attn_ext_f16_scratch_size(ctx->device, node, &k_bytes, &v_bytes);
+        if (k_bytes == 0 && v_bytes == 0) {
+            continue;
+        }
+        any_fa = true;
+        const int slot = ggml_cuda_v2_predict_fa_slot(ctx, cgraph, i);
+        if (slot < 0 || slot >= GGML_CUDA_MAX_STREAMS) {
+            GGML_LOG_ERROR("V2: stream-slot predictor returned out-of-range slot %d for FA node %d\n", slot, i);
+            return false;
+        }
+        if (k_bytes > need_k[slot]) need_k[slot] = k_bytes;
+        if (v_bytes > need_v[slot]) need_v[slot] = v_bytes;
+    }
+
+    if (!any_fa) {
+        return true;
+    }
+
+    // Step 4 + 5: reserve/grow per slot.
+    const int d = ctx->device;
+    for (int s = 0; s < GGML_CUDA_MAX_STREAMS; ++s) {
+        if (need_k[s] == 0 && need_v[s] == 0) {
+            continue;
+        }
+
+        fattn_scratch_slot & slot = ctx->fattn_scratch[d][s];
+        const bool grow_k = need_k[s] > slot.k_capacity;
+        const bool grow_v = need_v[s] > slot.v_capacity;
+        if (!grow_k && !grow_v) {
+            continue;
+        }
+
+        // Assert no active capture on this slot — guards against a future
+        // edit that moves reservation below cudaStreamBeginCapture in the
+        // same function. The §8 lock already prevents cross-thread interference.
+        if (ctx->streams[d][s] != nullptr) {
+            cudaStreamCaptureStatus cap_status = cudaStreamCaptureStatusNone;
+            cudaError_t cs = cudaStreamIsCapturing(ctx->streams[d][s], &cap_status);
+            if (cs == cudaSuccess && cap_status == cudaStreamCaptureStatusActive) {
+                GGML_LOG_ERROR("V2: stream %d on device %d is mid-capture at reservation site\n",
+                               s, d);
+                return false;
+            }
+        }
+
+        // Step 4: allocate new pointers (raw cudaError_t; preserve old on failure).
+        half * new_k = nullptr;
+        half * new_v = nullptr;
+        const size_t new_k_cap = grow_k ? need_k[s] : slot.k_capacity;
+        const size_t new_v_cap = grow_v ? need_v[s] : slot.v_capacity;
+
+        if (ggml_cuda_v2_consume_fa_scratch_failure_injection()) {
+            GGML_LOG_WARN("V2: failure injection: forcing fa-scratch reserve to fail (device %d slot %d)\n", d, s);
+            return false;
+        }
+
+        if (grow_k) {
+            cudaError_t status = cudaMalloc(reinterpret_cast<void **>(&new_k), new_k_cap);
+            if (status != cudaSuccess) {
+                GGML_LOG_ERROR("V2: cudaMalloc(K f16 scratch, %zu bytes) failed: %s\n",
+                               new_k_cap, cudaGetErrorString(status));
+                return false;
+            }
+        }
+        if (grow_v) {
+            cudaError_t status = cudaMalloc(reinterpret_cast<void **>(&new_v), new_v_cap);
+            if (status != cudaSuccess) {
+                GGML_LOG_ERROR("V2: cudaMalloc(V f16 scratch, %zu bytes) failed: %s\n",
+                               new_v_cap, cudaGetErrorString(status));
+                if (new_k != nullptr) {
+                    // Clean up the partial K-only allocation.
+                    cudaError_t fs = cudaFree(new_k);
+                    if (fs != cudaSuccess) {
+                        GGML_LOG_DEBUG("V2: cudaFree(partial K) returned %s\n", cudaGetErrorString(fs));
+                    }
+                }
+                return false;
+            }
+        }
+
+        // Step 5: prepare retired entry for the OLD pointers before swapping.
+        retired_fattn_alloc retired;
+        retired.device = d;
+        retired.stream_no = s;
+        if (grow_k) retired.k = slot.k;
+        if (grow_v) retired.v = slot.v;
+
+        // Snapshot which slots are populated NOW so step-1 drain knows which
+        // slots came into existence after retire (those need first-use events).
+        for (int s2 = 0; s2 < GGML_CUDA_MAX_STREAMS; ++s2) {
+            retired.populated_slots_at_retire[s2] = (ctx->streams[d][s2] != nullptr);
+        }
+
+        // Record one event on every populated launch stream for device d.
+        // cudaGraphLaunch enqueues through the launch stream (cuda_ctx->stream()
+        // at the call site), not the capture-time slot — a single event on
+        // slot s would miss past replays launched on slot 0 or other slots.
+        bool retire_event_ok = true;
+        for (int s2 = 0; s2 < GGML_CUDA_MAX_STREAMS; ++s2) {
+            if (!retired.populated_slots_at_retire[s2]) {
+                continue;
+            }
+            cudaEvent_t ev = nullptr;
+            cudaError_t status = cudaEventCreateWithFlags(&ev, cudaEventDisableTiming);
+            if (status != cudaSuccess) {
+                GGML_LOG_ERROR("V2: cudaEventCreateWithFlags failed: %s\n", cudaGetErrorString(status));
+                retire_event_ok = false;
+                break;
+            }
+            status = cudaEventRecord(ev, ctx->streams[d][s2]);
+            if (status != cudaSuccess) {
+                GGML_LOG_ERROR("V2: cudaEventRecord on slot %d failed: %s\n", s2, cudaGetErrorString(status));
+                cudaError_t ds = cudaEventDestroy(ev);
+                if (ds != cudaSuccess) {
+                    GGML_LOG_DEBUG("V2: cudaEventDestroy(unrecorded ev) returned %s\n", cudaGetErrorString(ds));
+                }
+                retire_event_ok = false;
+                break;
+            }
+            retired.events.push_back(ev);
+        }
+
+        if (!retire_event_ok) {
+            // Roll back: destroy any events we managed to record, free the
+            // new allocations, leave old pointers intact, propagate failure.
+            for (cudaEvent_t ev : retired.events) {
+                cudaError_t s2 = cudaEventDestroy(ev);
+                if (s2 != cudaSuccess) {
+                    GGML_LOG_DEBUG("V2: cudaEventDestroy(rollback) returned %s\n", cudaGetErrorString(s2));
+                }
+            }
+            if (grow_k && new_k != nullptr) {
+                cudaError_t fs = cudaFree(new_k);
+                if (fs != cudaSuccess) GGML_LOG_DEBUG("V2: cudaFree(rollback K) returned %s\n", cudaGetErrorString(fs));
+            }
+            if (grow_v && new_v != nullptr) {
+                cudaError_t fs = cudaFree(new_v);
+                if (fs != cudaSuccess) GGML_LOG_DEBUG("V2: cudaFree(rollback V) returned %s\n", cudaGetErrorString(fs));
+            }
+            return false;
+        }
+
+        // Swap in the new pointers. Old pointers move into `retired` (already done).
+        if (grow_k) {
+            slot.k = new_k;
+            slot.k_capacity = new_k_cap;
+        }
+        if (grow_v) {
+            slot.v = new_v;
+            slot.v_capacity = new_v_cap;
+        }
+
+#ifdef USE_CUDA_GRAPH
+        // Step 5 (continued): invalidate every cuda_graphs entry whose
+        // fa_borrowed_streams contains slot s. Use raw cudaError_t — a single
+        // bad entry must not abort iteration mid-map.
+        for (auto & [key, gp] : ctx->cuda_graphs) {
+            if (gp == nullptr || gp->fa_borrowed_streams.count(s) == 0) {
+                continue;
+            }
+            if (gp->instance != nullptr) {
+                cudaError_t st = cudaGraphExecDestroy(gp->instance);
+                if (st != cudaSuccess) {
+                    GGML_LOG_DEBUG("V2: cudaGraphExecDestroy in step 5 returned %s\n", cudaGetErrorString(st));
+                }
+                gp->instance = nullptr;
+            }
+            if (gp->graph != nullptr) {
+                cudaError_t st = cudaGraphDestroy(gp->graph);
+                if (st != cudaSuccess) {
+                    GGML_LOG_DEBUG("V2: cudaGraphDestroy in step 5 returned %s\n", cudaGetErrorString(st));
+                }
+                gp->graph = nullptr;
+            }
+            // Defensive: reset warmup_complete so the entry re-enters warmup
+            // even if a future edit to the existing :4252-equivalent block
+            // gates recapture on properties_changed instead of instance-null.
+            gp->warmup_complete = false;
+            gp->fa_borrowed_streams.clear();
+            // node_props is intentionally not cleared — preserving it costs
+            // nothing and avoids re-running property detection.
+        }
+#endif // USE_CUDA_GRAPH
+
+        // Move retire into the list (only if the old pointer was non-null;
+        // first-time allocation has nothing to retire).
+        if (retired.k != nullptr || retired.v != nullptr) {
+            ctx->retired_fattn_allocs.push_back(std::move(retired));
+        } else {
+            // First-time allocation: events recorded but no pointers to free.
+            // Destroy the events now to keep handles balanced.
+            for (cudaEvent_t ev : retired.events) {
+                cudaError_t s2 = cudaEventDestroy(ev);
+                if (s2 != cudaSuccess) {
+                    GGML_LOG_DEBUG("V2: cudaEventDestroy(first-alloc) returned %s\n", cudaGetErrorString(s2));
+                }
+            }
+        }
+    }
+
+    return true;
+}
