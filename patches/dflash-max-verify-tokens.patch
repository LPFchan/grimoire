+// Max verify-batch tokens for DFlash. Override with GGML_DFLASH_MAX_VERIFY_TOKENS env var.
+// Default 25 fits flat mode (16 draft + 1 bonus). Increase for DDTree tree-mode
+// with --spec-branch-budget > 0 (e.g. 48 for n_max=32 + budget=16).
+static int dflash_max_verify_tokens() {
+    static const int val = [] {
+        const char * e = getenv("GGML_DFLASH_MAX_VERIFY_TOKENS");
+        int v = e ? std::max(16, std::atoi(e)) : LLAMA_DFLASH_DEFAULT_VERIFY_TOKENS;
+        LLAMA_LOG_INFO("dflash: max_verify_tokens=%d (from %s)\n",
+            v, e ? "GGML_DFLASH_MAX_VERIFY_TOKENS" : "default");
+        return v;
+    }();
+    return val;
+}
