server {
	listen 80;
	server_name _;
	root /usr/share/nginx/html;

	gzip on;
	gzip_types text/css application/javascript application/json image/svg+xml;
	gzip_min_length 1024;

	# Vite fingerprints these, so they can be cached hard.
	location /assets/ {
		include /etc/nginx/security-headers.conf;
		add_header Cache-Control "public, max-age=31536000, immutable" always;
		try_files $uri =404;
	}

	# The gateway's stats endpoints, proxied so they are same-origin with the
	# page. The API key lives here and is attached on the way through, so the
	# browser never holds a credential and there is no sign-in step. Note this
	# makes anyone who can reach this site able to read these figures.
	location /stats/ {
		include /etc/nginx/security-headers.conf;
		add_header Cache-Control "no-store" always;

		proxy_pass ${GRIMOIRE_GATEWAY_URL}/stats/;
		proxy_set_header Authorization "Bearer ${GRIMOIRE_API_KEY}";
		proxy_set_header Host $host;
		proxy_http_version 1.1;

		# The dashboard polls; don't let a slow gateway pile up connections.
		proxy_connect_timeout 5s;
		proxy_read_timeout 30s;

		# Never let a credentialed response be stored by a shared cache.
		proxy_hide_header Set-Cookie;
		proxy_ignore_headers Set-Cookie Cache-Control Expires;
	}

	# Single page app: everything else resolves to the shell, which must never
	# be cached or a deploy leaves stale asset URLs behind.
	location / {
		include /etc/nginx/security-headers.conf;
		add_header Cache-Control "no-cache" always;
		try_files $uri /index.html;
	}
}
