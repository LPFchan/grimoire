GRIMOIRE_API_KEY=changeme
MODELS_DIR=/path/to/models
TEMPLATES_DIR=/path/to/templates
GRAMMARS_DIR=/path/to/structured-cot/grammars
TOKEN_STATS_PATH=/path/to/token-stats.json
MODELS_JSON_PATH=/path/to/grimoire/etc/models.json
DEV_SRC_BIND=/path/to/grimoire/src/grimoire
# Comma-separated browser origins allowed to call /stats from another site.
# The dashboard no longer needs this (nginx proxies /stats same-origin); leave
# empty unless some other browser app calls the gateway cross-site.
GRIMOIRE_CORS_ORIGINS=
# Days of raw 5s telemetry to keep. Rollups are never pruned, so lifetime
# graphs stay intact; this only costs fine detail on old windows. 0 = keep all.
GRIMOIRE_TELEMETRY_RETENTION_DAYS=30
